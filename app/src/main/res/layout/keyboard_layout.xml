<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="250dp"
    android:background="#1E1E1E" android:orientation="vertical" android:padding="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Saved Premium Emojis" android:textColor="#FFFFFF" android:textSize="14sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/emoji_recycler"
        android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" />
</LinearLayout>
